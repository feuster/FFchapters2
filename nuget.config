<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="LocalPackages" value="./FFchapters2/nuget" />
  </packageSources>
    <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalPackages">
      <package pattern="SharpSixel.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>